# Assignment VM: Ubuntu 24.04 Bento, 2 GiB RAM, guest Tomcat port 7070
# forwarded to host port 9090; guest Nginx port 80 to host port 80.
Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-24.04"
  config.vm.hostname = "ps-tomcat"
  config.vm.network "forwarded_port", guest: 7070, host: 9090, auto_correct: true
  config.vm.network "forwarded_port", guest: 80, host: 80, auto_correct: true
  config.vm.network "private_network", ip: "192.168.56.20"
  config.vm.synced_folder "../docker", "/vagrant-docker"
  config.vm.provider "virtualbox" do |vb|
    vb.memory = 2048
    vb.cpus = 2
  end
  config.vm.provision "shell", path: "provision.sh"
end
